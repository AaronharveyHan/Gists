{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2021", "DOM"],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@wdio/globals/types", "@wdio/native-types", "mocha"]
  },
  "include": ["e2e/**/*.ts", "wdio.conf.ts"],
  "exclude": ["node_modules", "src", "src-tauri", "dist"]
}
